{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/donationservice-worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8081"
      }
    }
  },
  "MongoDb": {
    "ConnectionString": "__SET_ME__",
    "DatabaseName": "donation_service",
    "DonationsCollectionName": "donations"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "DonationCreatedQueueName": "donation-created-queue",
    "PrefetchCount": 16,
    "ConcurrencyLimit": 8,
    "RetryCount": 5,
    "RetryIntervalSeconds": 5
  }
}
