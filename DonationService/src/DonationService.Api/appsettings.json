{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/donationservice-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DonationServiceDb": "Host=__SET_ME__;Port=5432;Database=postgres;Username=__SET_ME__;Password=__SET_ME__;SSL Mode=Require;Trust Server Certificate=true"
  },
  "MongoDb": {
    "ConnectionString": "__SET_ME__",
    "DatabaseName": "donation_service",
    "DonationsCollectionName": "donations"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "DonationCreatedQueueName": "donation-created-queue",
    "PrefetchCount": 16,
    "ConcurrencyLimit": 8,
    "RetryCount": 5,
    "RetryIntervalSeconds": 5
  },
  "Jwt": {
    "Issuer": "CampaignUserService",
    "Audience": "CampaignPlatform",
    "SecretKey": "__SET_ME__",
    "ClockSkewSeconds": 60
  },
  "CampaignService": {
    "BaseUrl": "http://localhost:5010/",
    "ValidationEndpointTemplate": "api/v1/campaigns/{campaignId}",
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  }
}
