# Copy this file to ".env" and fill in real values before running
# `docker compose up`. Never commit the real ".env" file.

# ---- ASP.NET Core ----
ASPNETCORE_ENVIRONMENT=Development

# ---- PostgreSQL (Supabase) ----
# If you're using the bundled local "postgres" container (docker compose
# --profile local-db up), point this at it, e.g.:
#   Host=postgres;Port=5432;Database=donationservice;Username=donationservice;Password=donationservice
# For Supabase, use the connection string from Project Settings > Database.
DONATIONSERVICE_DB_CONNECTION=Host=__SET_ME__;Port=5432;Database=postgres;Username=__SET_ME__;Password=__SET_ME__;SSL Mode=Require;Trust Server Certificate=true
POSTGRES_USER=donationservice
POSTGRES_PASSWORD=donationservice
POSTGRES_DB=donationservice
POSTGRES_PORT=5433

# ---- MongoDB ----
MONGODB_CONNECTION=mongodb://mongodb:27017
MONGO_DATABASE=donation_service
MONGO_PORT=27017

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- JWT (must match CampaignUserService's issuer/audience/secret exactly -
#      DonationService only validates tokens, it never issues them) ----
JWT_ISSUER=CampaignUserService
JWT_AUDIENCE=CampaignPlatform
JWT_SECRET_KEY=__SET_ME_MIN_32_CHARS__

# ---- CampaignService integration (Gateway) ----
CAMPAIGN_SERVICE_BASE_URL=http://campaignuserservice-api:8080/

# ---- Ports exposed on the host ----
API_PORT=8080
WORKER_PORT=8081
