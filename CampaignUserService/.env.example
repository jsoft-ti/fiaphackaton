# ---------------------------------------------------------------------------
# CampaignUserService - environment variables
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# ----- PostgreSQL (local docker-compose database) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campaign_user_service
POSTGRES_PORT=5432

# ----- Supabase PostgreSQL (production) -----
# When running against Supabase instead of the local docker-compose database,
# set the full connection string directly (overrides the composed value):
# ConnectionStrings__DefaultConnection=Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<your-password>;SSL Mode=Require;Trust Server Certificate=true

# ----- JWT -----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
JWT_ISSUER=CampaignUserService
JWT_AUDIENCE=CampaignUserService.Clients
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ----- Initial GestorOng administrator (seeded on first run) -----
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Master
ADMIN_EMAIL=admin@campanhas-sociais.org
ADMIN_PASSWORD=change-me-to-a-strong-password

# ----- SMTP (future email delivery - leave SMTP_ENABLED=false to log-only) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=no-reply@campanhas-sociais.org
SMTP_FROM_NAME=Campanhas Sociais
SMTP_ENABLED=false

# ----- CORS -----
CORS_ALLOWED_ORIGIN_0=http://localhost:3000

# ----- Api -----
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
DATABASE_AUTO_MIGRATE_AND_SEED=true
